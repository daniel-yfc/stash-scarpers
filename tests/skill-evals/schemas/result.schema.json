{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WS-F offline Skill evaluation report (unattested)",
  "type": "object",
  "required": [
    "status",
    "repository_sha",
    "skill_sha256",
    "cases",
    "summary",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "status": {
      "const": "OFFLINE_TRACE_ASSESSMENT_ONLY"
    },
    "repository_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "skill_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "limitations": {
      "type": "string",
      "minLength": 10
    },
    "summary": {
      "type": "object",
      "required": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ],
      "properties": {
        "PASS": {
          "type": "integer",
          "minimum": 0
        },
        "FAIL": {
          "type": "integer",
          "minimum": 0
        },
        "NOT_RUN": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "case_id",
          "status",
          "source_trust"
        ],
        "properties": {
          "case_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN"
            ]
          },
          "source_trust": {
            "enum": [
              "HOST_EXPORT_UNATTESTED",
              "SYNTHETIC_FIXTURE",
              "MISSING"
            ]
          },
          "trace_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
