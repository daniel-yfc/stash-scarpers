{
  "name": "stash-scraper-builder",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "overrides": {
    "whatwg-url": "^14.0.0",
    "tr46": "^4.1.1"
  },
  "scripts": {
    "validate": "node validator/index.mjs -a --ci",
    "validate-sort": "node validator/index.mjs -a -s --ci",
    "format": "npx --yes prettier@3.5.3 --write \"**/*.{md,yml,yaml,json,js}\"",
    "format:check": "npx --yes prettier@3.5.3 --check \"**/*.{md,yml,yaml,json,js}\"",
    "test": "node --test validator/*.test.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-ajv-errors": "^2.0.3",
    "chalk": "^5.6.2",
    "deno": "^2.9.6",
    "fuse.js": "^7.5.0",
    "jsdom": "^30.0.1",
    "yaml": "^2.9.1"
  }
}
